{
  "name": "rewaq-location",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:expire": "node --env-file=.env --import tsx scripts/expire.ts",
    "test:e2e": "node --env-file=.env scripts/e2e.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "framer-motion": "12.23.24",
    "gsap": "3.13.0",
    "lucide-react": "0.468.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "next": "^15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.6",
    "prettier": "3.10.1",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
